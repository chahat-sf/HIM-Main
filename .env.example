# Database
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Auth (16+ characters)
AUTH_SECRET=

# Public site URL for metadata / OG / absolute redirects (e.g. https://thehim.in).
# Required behind nginx→localhost:PORT so redirects do not use the internal origin.
NEXT_PUBLIC_SITE_URL=
SITE_URL=

# Search indexing: set true on thehim.in production. Leave unset/false on Vercel
# (him-main.vercel.app) so staging stays noindex.
NEXT_PUBLIC_ALLOW_INDEXING=

# Unreleased gate: when true, public visitors only see /coming-soon.
# Team unlock: GET /api/site-preview?secret=<SITE_PREVIEW_SECRET>
# Launch: set SITE_UNRELEASED=false (or remove) and redeploy.
SITE_UNRELEASED=false
SITE_PREVIEW_SECRET=

# Web Push (Coming Soon notify). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:wegotyou@thehim.in

# Razorpay (test or live). Key ID is public; secret is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PostHog hybrid analytics (omit KEY to disable tracking locally)
# Do not put comments on the same line as values — Next embeds them literally.
# Cloud US host: https://us.i.posthog.com
# Cloud EU host: https://eu.i.posthog.com
# Self-host: https://posthog.yourdomain.com (or http://localhost:8000)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
